# Vazio usa a Pages Function /api no mesmo domínio. Localmente, o Vite encaminha /api para 127.0.0.1:8787.
# Cadastro/login do aluno exigem a API local ativa e Cloudflare D1 com as migrações aplicadas.
# Se a API publicada estiver em outro domínio, informe sua URL HTTPS aqui.
VITE_API_URL=

# Número do WhatsApp com país e DDD, somente dígitos. Ex.: 5585999999999
# Enquanto estiver vazio, o aluno escolhe o contato ao abrir o WhatsApp.
VITE_WHATSAPP_NUMBER=

# Dados públicos necessários para gerar o QR Code PIX de Treinos Prontos.
VITE_PIX_KEY=
VITE_PIX_NAME=FARISA PERSONAL
VITE_PIX_CITY=FORTALEZA

# O pagamento automático usa o backend do Pages. MERCADO_PAGO_ACCESS_TOKEN e
# SESSION_SECRET ficam nos Secrets do Pages, nunca neste arquivo do navegador.

# Portfólio: mostra as contas de demonstração nas telas de login e esconde
# o "Esqueci a senha". Use false no site entregue a um cliente.
VITE_DEMO_MODE=true
