{
  // Worker pequeno que restaura a conta de demonstração todo dia.
  // Publicar (uma vez, e de novo quando mudar o demo-seed.sql):
  //   cd demo-reset && npx wrangler deploy
  "$schema": "../backend/node_modules/wrangler/config-schema.json",
  "name": "farisa-demo-reset",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  // Todo dia às 06:00 UTC (03:00 em Brasília/Fortaleza).
  "triggers": { "crons": ["0 6 * * *"] },
  // O arquivo .sql entra no worker como texto.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farisa-coach",
      "database_id": "989f69b1-a78f-422b-b53a-dfe1769a71d4",
      "migrations_dir": "../backend/migrations-d1",
    },
  ],
}
