{
  "name": "farisa-coach-cloudflare-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test-d1.mjs",
    "predev": "node scripts/setup-local.mjs",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "demo:remover:local": "wrangler d1 execute DB --local --file=scripts/remover-demo.sql",
    "demo:remover:remote": "wrangler d1 execute DB --remote --file=scripts/remover-demo.sql"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
