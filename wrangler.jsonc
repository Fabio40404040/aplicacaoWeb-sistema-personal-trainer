{
  "$schema": "./backend/node_modules/wrangler/config-schema.json",
  "name": "aplicacaoweb-sistema-personal-trainer",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farisa-coach",
      "database_id": "989f69b1-a78f-422b-b53a-dfe1769a71d4",
      "migrations_dir": "backend/migrations-d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "farisa-personal-media",
    },
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "farisa-coach",
          "database_id": "989f69b1-a78f-422b-b53a-dfe1769a71d4",
          "migrations_dir": "backend/migrations-d1",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "farisa-personal-media",
        },
      ],
      "vars": {
        "ALLOWED_ORIGIN": "https://farisafit.com.br",
        "PUBLIC_SITE_URL": "https://farisafit.com.br/",
        "PUBLIC_API_URL": "https://farisafit.com.br",
        "EMAIL_FROM": "contato@farisafit.com.br",
        "BREVO_FROM_NAME": "FARISA Personal Trainer",
        "SESSION_TTL_SECONDS": "43200",
      },
    },
  },
}
